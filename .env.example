# OpenAI (agent loop)
OPENAI_API_KEY=

# Dynamic server wallet / delegated access
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_TOKEN=
DYNAMIC_WALLET_PASSWORD=
# Optional: persisted wallet metadata JSON path (default: .data/wallet.json)
DYNAMIC_WALLET_STORE=.data/wallet.json

# Base Sepolia
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Optional private key for faucet/funding ops only — never commit
# FAUCET_PRIVATE_KEY=

# Dual agent wallets (v2)
# Execution = funded agent (swap / x402 / attestation deploy+write)
# EXECUTION_AGENT_PRIVATE_KEY=
# Alias still accepted:
# DEMO_AGENT_PRIVATE_KEY=
# Proof-agent: optional; auto-generated to .data/proof-agent.key if unset
# PROOF_AGENT_PRIVATE_KEY=

# Reputation attestation (Base Sepolia) — set after deploy:reputation
# REPUTATION_CONTRACT=

# x402 compliance-check (agent self-funding)
X402_PAY_TO=
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PRICE=$0.001
# Circle USDC on Base Sepolia
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Uniswap Trading API is unused. Base Sepolia ETH/USDC 404’d; live path is SwapRouter02.
# UNISWAP_API_KEY=

# Delegation webhook (Phase 8)
DELEGATION_WEBHOOK_SECRET=
DELEGATION_STORE=.data/delegation.json

# Demo mode: use mock swap when Uniswap liquidity unavailable
# Uniswap: true only after a confirmed live swap tx
UNISWAP_LIVE=true
SWAP_PROVIDER=auto
PROOFPORT_BASE_URL=http://localhost:3000

# Optional WSL Dynamic Neon signer (Linux). Windows Next.js probes this.
DYNAMIC_WSL_SIGNER_URL=http://127.0.0.1:18787
